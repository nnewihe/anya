# Copy to .env and adjust. The API and worker read these from the environment.

ENV=dev

# Redis — Celery broker + job-state store. In AWS use the ElastiCache endpoint.
REDIS_URL=redis://localhost:6379/0

# Storage backend: "local" (dev) or "s3" (production).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/rally-media

# S3 (only when STORAGE_BACKEND=s3)
S3_BUCKET=rally-predictor-media
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from the environment or, on
# EC2/ECS, the instance/task IAM role (preferred — no static keys).
# S3_ENDPOINT_URL=http://localhost:9000   # only for MinIO/localstack
PRESIGN_EXPIRY_SEC=3600

# Where the rally_detector pipeline + models/ live. In Docker this is baked in.
# PIPELINE_DIR=/app/pipeline

# Max upload size (bytes). Default 8 GiB.
MAX_UPLOAD_BYTES=8589934592

# CORS — "*" is fine for the mobile app; restrict if you add a web client.
CORS_ORIGINS=*
