# Ultralytics auto-downloads model weights into the CWD when a model is
# named without a path (walking/extract_pose.py, pipeline/anya_end_telemetry.py).
# The real copy is tracked at pipeline/models/yolov8n-pose.pt.
/yolov8n-pose.pt

# Firebase Cloud Functions (billing + entitlements). node_modules and the
# TypeScript build output are regenerated by `npm ci && npm run build`.
functions/node_modules/
functions/lib/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pglite-debug.log
database-debug.log
pubsub-debug.log

# Credentials that must never reach the repo or the bundle. The client only
# ever carries public identifiers (see desktop/firebase_config.py); anything
# matched here is a server secret and belongs in Google Secret Manager.
*.p8
serviceAccount*.json
.env
.env.*
.runtimeconfig.json
