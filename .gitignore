backend/app/__pycache__/
__pycache__/
.DS_Store
.claude/

# Ultralytics auto-downloads model weights into the CWD when a model is
# named without a path (walking/extract_pose.py, pipeline/anya_end_telemetry.py).
# The real copy is tracked at pipeline/models/yolov8n-pose.pt.
/yolov8n-pose.pt

# Firebase Cloud Functions (billing + entitlements). node_modules and the
# TypeScript build output are regenerated by `npm ci && npm run build`.
functions/node_modules/
functions/lib/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pglite-debug.log
database-debug.log
pubsub-debug.log

# Credentials that must never reach the repo or the bundle. The client only
# ever carries public identifiers (see desktop/firebase_config.py); anything
# matched here is a server secret and belongs in Google Secret Manager.
*.p8
serviceAccount*.json
.env
.env.*
.runtimeconfig.json

# Google OAuth Desktop client id and secret, injected at build time.
# NOT committed even though RFC 8252 calls an installed app's secret
# non-confidential — this repository is public, and a scraped id+secret lets
# someone show our consent screen to our own users.
# See desktop/oauth_client.example.py.
desktop/oauth_client.py

# Pose model exports for pipeline/anya2/pose_backend.py -- generated per
# machine and per far-band shape by export_pose.py, never committed.
pipeline/models/pose/

# The Pi service's YouTube OAuth client and refresh token (pi/README.md).
client_secret*.json
youtube_token.json
